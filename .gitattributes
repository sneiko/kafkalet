# Auto-detect text files and normalize line endings
* text=auto

# Go source files always use LF
*.go text eol=lf

# Frontend source files always use LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.html text eol=lf

# Config files
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf

# Binary files
*.png binary
*.ico binary
*.icns binary
*.exe binary
*.app binary
*.zip binary
*.tar.gz binary
